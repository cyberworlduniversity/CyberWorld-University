rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "student";
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /course_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /course_phases/{phaseId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      // Enrollment writes are performed by the trusted Flask backend.
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /lesson_progress/{progressId} {
      // Progress writes are performed by the trusted Flask backend.
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /quiz_questions/{quizQuestionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /exam_questions/{examQuestionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /quiz_attempts/{attemptId} {
      // Quiz attempts are created and scored by the trusted Flask backend.
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /exam_attempts/{attemptId} {
      // Examination attempts are created and scored by the trusted Flask backend.
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /advertisements/{advertisementId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
    }

    match /website_content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}